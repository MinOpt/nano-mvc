{
    "name": "minopt/nano-mvc",
    "description": "A zero-bloat PHP micro-framework for simple projects. Router + Request/Response + Views. No DI, no middleware, no magic.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "scripts": {
        "start": "php -S localhost:8000 router.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}